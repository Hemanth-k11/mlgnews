# Copy to ".env" and fill in real values.
#
# The app runs on PostgreSQL. Get the two URLs from your Neon database
# (Vercel -> Storage -> your database -> ".env.local" tab).

# Pooled connection (host contains "-pooler") — used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Direct connection (no "-pooler") — used by prisma db push / migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"

# Signs the admin login cookie. Any long random string.
AUTH_SECRET="a-long-random-string-at-least-32-characters"

# Password for the first super admin (karlapati.hemanth@gmail.com). Only used by
# `npm run db:seed` on a database that has no staff accounts yet.
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# ---- Image uploads (optional locally; required on Vercel) ----
# Without these, uploads are written to /public/uploads on disk.
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# ---- Email (password reset for staff) — REQUIRED for "Forgot password" ----
# Mail is sent over SMTP; Gmail works out of the box:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Google Account -> Security -> App passwords -> create one for "Mail".
#   3. Put that Gmail address and the 16-character app password below
#      (also add them as Vercel environment variables).
# Without these, "Forgot password" refuses to run and says so. (Adding staff does not need email.)
SMTP_USER="your-sending-address@gmail.com"
SMTP_PASS="your-16-character-app-password"
# Optional: the From line. Defaults to "Miryalaguda Chronicle <SMTP_USER>".
# EMAIL_FROM="Miryalaguda Chronicle <your-sending-address@gmail.com>"
# Optional: a different SMTP server (defaults to smtp.gmail.com, port 465, TLS).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

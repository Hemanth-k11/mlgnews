# Copy to ".env" and fill in real values.

# ---- Local development (SQLite + local file uploads) ----
DATABASE_URL="file:./dev.db"
AUTH_SECRET="a-long-random-string-at-least-32-characters"

# ---- Production (see DEPLOY.md) ----
# Postgres from Neon — pooled URL for the app, direct URL for migrations:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"

# Cloudinary for image uploads (unsigned preset):
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

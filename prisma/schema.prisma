// Prisma schema — the shape of the database.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String // bcrypt hash, never plain text
  role      String    @default("editor") // "super_admin" | "admin" | "editor" | "author"
  createdAt DateTime  @default(now())
  articles  Article[]

  // Profile
  username    String?   @unique
  avatarUrl   String?
  dateOfBirth DateTime?
  city        String    @default("")
  address     String    @default("")
  bio         String    @default("")
  profession  String    @default("")
}

// A public reader account (sign up / sign in on the site). Separate from
// User, which is staff (admin/editor/author) and can access /admin.
model Reader {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // bcrypt hash, never plain text
  createdAt DateTime @default(now())

  // Set at sign up if the reader checks "request admin/staff access".
  // Reviewed by an existing admin on /admin/requests.
  adminRequestStatus String @default("none") // "none" | "pending" | "approved" | "rejected"
  adminRequestNote   String @default("") // optional message from the reader

  // Profile
  username    String?   @unique
  avatarUrl   String?
  dateOfBirth DateTime?
  city        String    @default("")
  address     String    @default("")
  bio         String    @default("")
  profession  String    @default("")

  likes       Like[]
  comments    Comment[]
  resetTokens PasswordResetToken[]
}

// A one-time link emailed to a reader so they can set a new password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  readerId String
  reader   Reader @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@index([readerId])
}

// One reader's like on one article.
model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readerId  String
  reader    Reader  @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([articleId, readerId])
  @@index([articleId])
}

// A reader's comment on an article.
model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readerId  String
  reader    Reader  @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  blurb    String? // one-line description shown on the section page
  order    Int       @default(0) // controls order in the nav
  articles Article[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String    @default("")
  body        String    @default("") // Markdown
  heroImage   String? // image URL (paste one in the admin)
  heroAlt     String?
  heroCaption String?
  status      String    @default("draft") // "draft" | "published"
  featured    Boolean   @default(false) // the one story in the homepage hero
  tags        String    @default("") // comma-separated, kept simple for v1
  views       Int       @default(0) // powers "Most Read"
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  editionItems EditionItem[]
  images       ArticleImage[]
  likes        Like[]
  comments     Comment[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

// Extra images attached to an article (the "in pictures" gallery).
// The main/hero image stays on Article.heroImage.
model ArticleImage {
  id        String   @id @default(cuid())
  url       String
  alt       String   @default("")
  caption   String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, order])
}

// One dated "digital edition" of the paper (the e-Paper).
model Edition {
  id        String   @id @default(cuid())
  date      DateTime @unique // stored at UTC midnight; one edition per day
  title     String   @default("Miryalaguda Chronicle") // nameplate line
  strapline String   @default("Digital Edition")
  status    String   @default("draft") // "draft" | "published"
  pdfUrl    String? // optional link to a real print-replica PDF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items EditionItem[]
}

// A banner advertisement for one placement on the site. Managed from /admin/ads.
model Ad {
  id        String   @id @default(cuid())
  placement String   @unique // "home-rail" | "article-rail" | "section-rail"
  name      String   @default("Ad slot") // internal label
  imageUrl  String   @default("") // uploaded file path or external URL
  linkUrl   String   @default("") // click-through target
  alt       String   @default("Advertisement")
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// A story placed on a page of an edition.
model EditionItem {
  id         String  @id @default(cuid())
  page       Int     @default(1)
  order      Int     @default(0)
  prominence String  @default("standard") // "lead" | "standard" | "brief"

  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([editionId, articleId])
  @@index([editionId, page, order])
}
